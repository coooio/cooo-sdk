# Copy to .env in the repository root and replace every placeholder.
# Use a local synthetic Lyquor devnet with four distinct unlocked test accounts.
COOO_RPC_URL=http://127.0.0.1:8080/lyquid/api
COOO_INFO_URL=http://127.0.0.1:8080/lyquid/info
COOO_STATE_URL=http://127.0.0.1:8080/api/state
COOO_LYQUID_ID=Lyquid-replace-me
COOO_CONTRACT=0x0000000000000000000000000000000000000000
COOO_OPERATOR=0x0000000000000000000000000000000000000000
COOO_REQUESTER=0x0000000000000000000000000000000000000000
COOO_PROVIDER=0x0000000000000000000000000000000000000000
COOO_REVIEWER=0x0000000000000000000000000000000000000000
COOO_TASK_ID=quickstart-001
COOO_DEADLINE=2027-01-01T00:00:00.000Z
# Optional: path to a different evidence file. Its bytes must remain unchanged on resume.
# COOO_EVIDENCE_FILE=./evidence.txt
